{
  "name": "kpfk-archive",
  "version": "1.0.0",
  "description": "KPFK archive using Pacifica JSON feeds",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node tools/start.js",
    "test": "node tools/run-tests.js",
    "audit:schedule": "node tools/schedule-audit.js",
    "check:storage": "node tools/check-storage-safety.js",
    "hooks:install": "git config core.hooksPath .githooks && echo \"hooks installed (core.hooksPath=.githooks)\"",
    "test:pacifica": "node --test test/pacifica/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
