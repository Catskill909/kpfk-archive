# KPFK Archive settings. Node does not read .env files: `npm start` supplies the
# local values below, and a container gets them from its service environment
# (Coolify → Environment Variables). Everything has a working default.

# ---- Local development (npm start) ----
STATION_PROFILE=stations/kpfk.json
PORT=8081
DATA_DIR=./data

# ---- Container / Coolify ----
# The image already sets STATION_PROFILE=stations/kpfk.json, PORT=8080,
# NODE_ENV=production, and DATA_DIR defaults to /app/data. Do not set them.
# Do not set STATION_ID or STATION_TZ either: identity and timezone come from the
# station profile, and a mismatching value refuses to boot.

# The only value you must add. Enables the station view at /studio; unset, the
# routes do not exist at all. 12+ characters. Mark it runtime-only in Coolify
# (not a build variable) so it is never baked into an image layer. Changing it
# signs everyone out — the only way to revoke a session.
# STUDIO_PASSWORD=

# Optional. Signs sessions with this instead of a key derived from the password.
# Leave unset unless you need to rotate sessions without changing the password.
# STUDIO_SECRET=
# STUDIO_SESSION_HOURS=8760

# on (default) counts plays/page views with no identifiers; off registers no route.
USAGE_TRACKING=on

# Optional KPFK QIR beta connection. Runtime-only; never put the key in a station
# profile, browser script, image build, or committed file. Missing = archive preview.
# Node does not automatically load this file. Supply through the server environment.
# QIR_API_KEY=

# Artwork is loaded into memory at start (default). off = skip the warm-up (offline tests).
# ARTWORK_WARM=off
