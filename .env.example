# KPFK deployment settings. npm start supplies the profile, port 8081 and local
# ./data explicitly. Node does not automatically read .env files.
# For deployment, configure these values in the service environment.
STATION_PROFILE=stations/kpfk.json
PORT=8081
# Use an independent local directory. In a container set DATA_DIR=/app/data
# and mount a dedicated KPFK persistent volume there.
DATA_DIR=./data
# Identity and timezone come from the station profile. If STATION_ID/STATION_TZ
# are explicitly supplied they must match it.
# STUDIO_PASSWORD=
# STUDIO_SECRET=
# STUDIO_SESSION_HOURS=8760
USAGE_TRACKING=on
